import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
ext = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

# Compute 3D centroid of the cube in world frame from the mask
ys, xs = np.where(mask > 0)
zs = depth[ys, xs]
valid = zs > 0
xs, ys, zs = xs[valid], ys[valid], zs[valid]
fx, fy = K[0, 0], K[1, 1]
cx, cy = K[0, 2], K[1, 2]
X = (xs - cx) * zs / fx
Y = (ys - cy) * zs / fy
Z = zs
pts_cam = np.stack([X, Y, Z], axis=1)
pts_cam_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0], 1))], axis=1)
pts_world = (ext @ pts_cam_h.T).T[:, :3]
center = pts_world.mean(axis=0)
print("cube center world:", center)

# Top-down grasp orientation (gripper pointing down)
top_down_quat = np.array([0.0, 1.0, 0.0, 0.0])

pre_pos = center.copy()
pre_pos[2] += 0.15
open_gripper()
joints = solve_ik(pre_pos, top_down_quat)
move_to_joints(joints)

grasp_pos = center.copy()
grasp_pos[2] += 0.005
joints = solve_ik(grasp_pos, top_down_quat)
move_to_joints(joints)

close_gripper()

lift_pos = center.copy()
lift_pos[2] += 0.2
joints = solve_ik(lift_pos, top_down_quat)
move_to_joints(joints)
print("done", center)


