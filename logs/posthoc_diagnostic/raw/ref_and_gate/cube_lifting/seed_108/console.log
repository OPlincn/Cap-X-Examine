# Code block 0
import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
extr = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=mask)
best_idx = int(grasp_scores.argmax())
best_T = grasp_poses[best_idx]
grasp_world = extr @ best_T

# compute object center in world via mask points
ys, xs = np.where(mask)
zs = depth[ys, xs]
fx, fy = K[0,0], K[1,1]
cx, cy = K[0,2], K[1,2]
X = (xs - cx) * zs / fx
Y = (ys - cy) * zs / fy
pts_cam = np.stack([X, Y, zs], axis=1)
pts_cam_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0],1))], axis=1)
pts_world = (extr @ pts_cam_h.T).T[:, :3]
center = pts_world.mean(axis=0)

# approach from above
target_pos = center + np.array([0,0,0.15])
quat = np.array([0.0, 1.0, 0.0, 0.0])  # pointing down
joints = solve_ik(target_pos, quat)
move_to_joints(joints)
open_gripper()

# descend to grasp
grasp_pos = center + np.array([0,0,0.02])
joints = solve_ik(grasp_pos, quat)
move_to_joints(joints)
close_gripper()

# lift
lift_pos = center + np.array([0,0,0.2])
joints = solve_ik(lift_pos, quat)
move_to_joints(joints)
print("done", center)

# Code block 1
import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
extr = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

# Compute object center and top surface in world frame
ys, xs = np.where(mask)
zs = depth[ys, xs]
fx, fy = K[0,0], K[1,1]
cx, cy = K[0,2], K[1,2]
X = (xs - cx) * zs / fx
Y = (ys - cy) * zs / fy
pts_cam = np.stack([X, Y, zs], axis=1)
pts_cam_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0],1))], axis=1)
pts_world = (extr @ pts_cam_h.T).T[:, :3]
center = pts_world.mean(axis=0)
top_z = pts_world[:,2].max()
print("center", center, "top_z", top_z)

# Use grasp pose from planner, transformed to world
grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=mask)
best_idx = int(grasp_scores.argmax())
best_T = grasp_poses[best_idx]
grasp_world = extr @ best_T
grasp_pos = grasp_world[:3, :3]  # rotation
grasp_xyz = grasp_world[:3, 3]
print("grasp_xyz", grasp_xyz)

# Convert rotation matrix to quaternion (wxyz)
R = grasp_world[:3, :3]
tr = R[0,0] + R[1,1] + R[2,2]
if tr > 0:
    S = np.sqrt(tr + 1.0) * 2
    w = 0.25 * S
    x = (R[2,1] - R[1,2]) / S
    y = (R[0,2] - R[2,0]) / S
    z = (R[1,0] - R[0,1]) / S
else:
    if R[0,0] > R[1,1] and R[0,0] > R[2,2]:
        S = np.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w = (R[2,1] - R[1,2]) / S
        x = 0.25 * S
        y = (R[0,1] + R[1,0]) / S
        z = (R[0,2] + R[2,0]) / S
    elif R[1,1] > R[2,2]:
        S = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
quat = np.array([w, x, y, z])
quat = quat / np.linalg.norm(quat)

# Pre-grasp above
pre_pos = grasp_xyz + np.array([0, 0, 0.12])
joints = solve_ik(pre_pos, quat)
move_to_joints(joints)
open_gripper()

# Descend to grasp position
joints = solve_ik(grasp_xyz, quat)
move_to_joints(joints)
close_gripper()

# Lift
lift_pos = grasp_xyz + np.array([0, 0, 0.2])
joints = solve_ik(lift_pos, quat)
move_to_joints(joints)
print("done")


