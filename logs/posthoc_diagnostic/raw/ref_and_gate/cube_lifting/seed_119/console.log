# Code block 1
import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
ext = cam["pose_mat"]
masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)
grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=mask)
best_idx = int(grasp_scores.argmax())
best_T = grasp_poses[best_idx]
world_T = ext @ best_T

# Extract grasp position and orientation
pos = world_T[:3, 3]
R = world_T[:3, :3]

# Convert rotation matrix to quaternion (wxyz)
def rot_to_quat(R):
    tr = np.trace(R)
    if tr > 0:
        S = np.sqrt(tr + 1.0) * 2
        w = 0.25 * S
        x = (R[2,1] - R[1,2]) / S
        y = (R[0,2] - R[2,0]) / S
        z = (R[1,0] - R[0,1]) / S
    elif (R[0,0] > R[1,1]) and (R[0,0] > R[2,2]):
        S = np.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w = (R[2,1] - R[1,2]) / S
        x = 0.25 * S
        y = (R[0,1] + R[1,0]) / S
        z = (R[0,2] + R[2,0]) / S
    elif R[1,1] > R[2,2]:
        S = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
    return np.array([w, x, y, z])

quat = rot_to_quat(R)
quat = quat / np.linalg.norm(quat)

# Approach from above: pre-grasp position
pre_pos = pos + np.array([0.0, 0.0, 0.10])

open_gripper()
joints_pre = solve_ik(pre_pos, quat)
move_to_joints(joints_pre)

# Move down to grasp
joints_grasp = solve_ik(pos, quat)
move_to_joints(joints_grasp)

close_gripper()

# Lift
lift_pos = pos + np.array([0.0, 0.0, 0.15])
joints_lift = solve_ik(lift_pos, quat)
move_to_joints(joints_lift)

print("grasp pos", pos)
print("lift pos", lift_pos)


