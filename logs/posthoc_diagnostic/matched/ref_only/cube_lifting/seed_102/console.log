# Code block 0
import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
ext = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=mask)
best_idx = int(np.argmax(grasp_scores))
T_cam = grasp_poses[best_idx]
T_world = ext @ T_cam

pos = T_world[:3, 3]
R = T_world[:3, :3]

# Convert rotation to quaternion (wxyz)
def rot_to_quat(R):
    t = np.trace(R)
    if t > 0:
        s = np.sqrt(t + 1.0) * 2
        w = 0.25 * s
        x = (R[2,1] - R[1,2]) / s
        y = (R[0,2] - R[2,0]) / s
        z = (R[1,0] - R[0,1]) / s
    elif R[0,0] > R[1,1] and R[0,0] > R[2,2]:
        s = np.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w = (R[2,1] - R[1,2]) / s
        x = 0.25 * s
        y = (R[0,1] + R[1,0]) / s
        z = (R[0,2] + R[2,0]) / s
    elif R[1,1] > R[2,2]:
        s = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / s
        x = (R[0,1] + R[1,0]) / s
        y = 0.25 * s
        z = (R[1,2] + R[2,1]) / s
    else:
        s = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / s
        x = (R[0,2] + R[2,0]) / s
        y = (R[1,2] + R[2,1]) / s
        z = 0.25 * s
    return np.array([w, x, y, z])

quat = rot_to_quat(R)
quat = quat / np.linalg.norm(quat)

# Approach from above
pre_pos = pos + np.array([0, 0, 0.1])
open_gripper()
joints = solve_ik(pre_pos, quat)
move_to_joints(joints)

joints = solve_ik(pos, quat)
move_to_joints(joints)

close_gripper()

lift_pos = pos + np.array([0, 0, 0.15])
joints = solve_ik(lift_pos, quat)
move_to_joints(joints)
print("done")

# Code block 1
import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
ext = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

# Get 3D points of the cube in camera frame to find its center
ys, xs = np.where(mask > 0)
zs = depth[ys, xs]
valid = zs > 0
xs, ys, zs = xs[valid], ys[valid], zs[valid]
fx, fy = K[0,0], K[1,1]
cx, cy = K[0,2], K[1,2]
X = (xs - cx) * zs / fx
Y = (ys - cy) * zs / fy
Z = zs
pts_cam = np.stack([X, Y, Z], axis=1)

# Transform to world frame
pts_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0],1))], axis=1)
pts_world = (ext @ pts_h.T).T[:, :3]

center = pts_world.mean(axis=0)
print("cube center world:", center)

# Grasp from above with gripper pointing down
# Panda hand with identity-ish orientation pointing down: quaternion for 180deg about x -> w=0,x=1,y=0,z=0
quat_down = np.array([0.0, 1.0, 0.0, 0.0])

# Approach above the cube
pre_pos = center + np.array([0, 0, 0.12])
open_gripper()
joints = solve_ik(pre_pos, quat_down)
move_to_joints(joints)

# Move down to grasp height (slightly above table, at cube center height)
grasp_pos = center + np.array([0, 0, 0.0])
joints = solve_ik(grasp_pos, quat_down)
move_to_joints(joints)

close_gripper()

# Lift
lift_pos = center + np.array([0, 0, 0.2])
joints = solve_ik(lift_pos, quat_down)
move_to_joints(joints)
print("done")


