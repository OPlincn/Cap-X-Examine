        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
    q = np.array([w, x, y, z])
    return q / np.linalg.norm(q)

# --- Step 1: Grasp the green cube (currently on top) and move it aside ---
green_grasp_poses, green_grasp_scores = plan_grasp(
    depth=depth, intrinsics=K, segmentation=green_mask.astype(np.int32))
g_idx = green_grasp_scores.argmax()
green_T_world = cam_ext @ green_grasp_poses[g_idx]
green_grasp_pos = green_T_world[:3, 3]
green_grasp_quat = rot_to_quat(green_T_world[:3, :3])

