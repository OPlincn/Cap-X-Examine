        S = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
    q = np.array([w, x, y, z])
    return q / np.linalg.norm(q)

# Grasp the red cube (currently held / near gripper). Re-plan grasp on red.
red_grasp_poses, red_grasp_scores = plan_grasp(
    depth=depth, intrinsics=K, segmentation=red_mask.astype(np.int32))
r_idx = red_grasp_scores.argmax()
red_T_world = cam_ext @ red_grasp_poses[r_idx]
red_grasp_pos = red_T_world[:3, 3]
red_grasp_quat = rot_to_quat(red_T_world[:3, :3])

# Ensure we are holding the red cube
move_to_joints(solve_ik(red_grasp_pos + np.array([0, 0, 0.10]), red_grasp_quat))
open_gripper()
move_to_joints(solve_ik(red_grasp_pos, red_grasp_quat))
close_gripper()

red_lift_pos = red_grasp_pos + np.array([0, 0, 0.20])
move_to_joints(solve_ik(red_lift_pos, red_grasp_quat))

# Place red cube on top of green cube (green is on the table)
green_top_z = green_center[2] + green_obb["extent"][2] / 2.0
red_half_z = red_obb["extent"][2] / 2.0
place_center = np.array([green_center[0], green_center[1], green_top_z + red_half_z])

red_offset = red_center - red_grasp_pos
place_grasp_pos = place_center - red_offset

move_to_joints(solve_ik(place_grasp_pos + np.array([0, 0, 0.12]), red_grasp_quat))
move_to_joints(solve_ik(place_grasp_pos, red_grasp_quat))
open_gripper()
move_to_joints(solve_ik(place_grasp_pos + np.array([0, 0, 0.15]), red_grasp_quat))


