r_idx = red_grasp_scores.argmax()
red_T_world = cam_ext @ red_grasp_poses[r_idx]
red_grasp_pos = red_T_world[:3, 3]
red_grasp_quat = rot_to_quat(red_T_world[:3, :3])

move_to_joints(solve_ik(red_grasp_pos + np.array([0, 0, 0.10]), red_grasp_quat))
open_gripper()
move_to_joints(solve_ik(red_grasp_pos, red_grasp_quat))
close_gripper()

red_lift_pos = red_grasp_pos + np.array([0, 0, 0.20])
move_to_joints(solve_ik(red_lift_pos, red_grasp_quat))

# Place red cube on top of green cube (green now at aside_center)
green_top_z = aside_center[2] + green_obb["extent"][2] / 2.0
red_half_z = red_obb["extent"][2] / 2.0
place_center = np.array([aside_center[0], aside_center[1], green_top_z + red_half_z])

red_offset = red_center - red_grasp_pos
place_grasp_pos = place_center - red_offset

move_to_joints(solve_ik(place_grasp_pos + np.array([0, 0, 0.12]), red_grasp_quat))
move_to_joints(solve_ik(place_grasp_pos, red_grasp_quat))
