green_offset = green_center - green_grasp_pos
aside_center = green_center + np.array([0.20, 0.0, 0.0])
aside_grasp_pos = aside_center - green_offset
move_to_joints(solve_ik(aside_grasp_pos + np.array([0, 0, 0.10]), green_grasp_quat))
move_to_joints(solve_ik(aside_grasp_pos, green_grasp_quat))
open_gripper()
move_to_joints(solve_ik(aside_grasp_pos + np.array([0, 0, 0.15]), green_grasp_quat))

# --- Step 2: Grasp the red cube and place it on top of the green cube ---
red_grasp_poses, red_grasp_scores = plan_grasp(
