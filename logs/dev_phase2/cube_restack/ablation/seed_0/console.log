# green cube first, then place the red cube on top of the green cube.
# Strategy: grasp the green cube, move it aside, then grasp the red cube and
# place it on top of the green cube.

def rot_to_quat(R):
    tr = R[0,0] + R[1,1] + R[2,2]
    if tr > 0:
        S = np.sqrt(tr + 1.0) * 2
        w = 0.25 * S
        x = (R[2,1] - R[1,2]) / S
        y = (R[0,2] - R[2,0]) / S
