# Determine which is on top by z
if red_center[2] > green_center[2]:
    top_mask, top_obb, top_name = red_mask, red_obb, "red"
    bottom_mask, bottom_obb, bottom_name = green_mask, green_obb, "green"
else:
    top_mask, top_obb, top_name = green_mask, green_obb, "green"
    bottom_mask, bottom_obb, bottom_name = red_mask, red_obb, "red"
print("top:", top_name, "bottom:", bottom_name)

# Grasp the top cube
