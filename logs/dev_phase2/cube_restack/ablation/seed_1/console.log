bottom_half_z = bottom_obb["extent"][2] / 2.0
target_xy = lower[:2]
target_z = top_top_z + bottom_half_z + 0.005

above_target = np.array([target_xy[0], target_xy[1], target_z + 0.12])
move_to_joints(solve_ik(above_target, b_grasp_quat))
place_target = np.array([target_xy[0], target_xy[1], target_z])
move_to_joints(solve_ik(place_target, b_grasp_quat))
open_gripper()
final_retreat = place_target.copy(); final_retreat[2] += 0.15
move_to_joints(solve_ik(final_retreat, b_grasp_quat))

