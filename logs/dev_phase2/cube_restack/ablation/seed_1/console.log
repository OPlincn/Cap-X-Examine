lower = setdown.copy(); lower[2] -= 0.15
move_to_joints(solve_ik(lower, top_grasp_quat))
open_gripper()
retreat = lower.copy(); retreat[2] += 0.15
move_to_joints(solve_ik(retreat, top_grasp_quat))

# Now grasp the bottom cube (which is now exposed)
bottom_seg = bottom_mask.astype(np.int32)
b_poses, b_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=bottom_seg)
