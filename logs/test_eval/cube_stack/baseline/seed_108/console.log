# Compute placement position: on top of green cube
# Green cube top surface height
green_top_z = green_center[2] + green_extent[2] / 2.0
# Red cube half-height (use extent z)
red_half_z = red_extent[2] / 2.0

# Target position for red cube center when placed on green
place_center = np.array([green_center[0], green_center[1], green_top_z + red_half_z])

# The grasp offset: gripper holds cube at grasp_pos relative to cube center
# Offset from cube center to grasp point (in world frame)
grasp_offset = grasp_pos - red_center

# Target grasp position when cube is placed
place_grasp_pos = place_center + grasp_offset

# Move above placement location first
above_place = place_grasp_pos + np.array([0, 0, 0.12])
joints = solve_ik(above_place, grasp_quat)
move_to_joints(joints)

# Lower to place
joints = solve_ik(place_grasp_pos, grasp_quat)
move_to_joints(joints)

# Open gripper to release
open_gripper()

# Retreat upward
retreat_pos = place_grasp_pos + np.array([0, 0, 0.12])
joints = solve_ik(retreat_pos, grasp_quat)
move_to_joints(joints)

