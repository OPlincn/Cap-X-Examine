move_to_joints(joints)
joints = solve_ik(grasp_pos, grasp_quat)
move_to_joints(joints)
close_gripper()

# Lift
joints = solve_ik(grasp_pos + np.array([0, 0, 0.15]), grasp_quat)
move_to_joints(joints)

# Place on top of green cube
place_z = green_center[2] + green_extent[2] / 2.0 + red_extent[2] / 2.0 + 0.005
place_pos = np.array([green_center[0], green_center[1], place_z])

joints = solve_ik(place_pos + np.array([0, 0, 0.10]), grasp_quat)
