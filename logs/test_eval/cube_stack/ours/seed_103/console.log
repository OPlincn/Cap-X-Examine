import numpy as np

obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
cam_ext = cam["pose_mat"]

fx, fy = K[0,0], K[1,1]
cx, cy = K[0,2], K[1,2]

def mask_to_world_points(mask):
    ys, xs = np.where(mask)
    zs = depth[ys, xs]
    valid = zs > 0
    xs, ys, zs = xs[valid], ys[valid], zs[valid]
    X = (xs - cx) * zs / fx
    Y = (ys - cy) * zs / fy
    Z = zs
    pts_cam = np.stack([X, Y, Z], axis=1)
    pts_world = (cam_ext[:3,:3] @ pts_cam.T).T + cam_ext[:3,3]
    return pts_world

def rot_to_quat(R):
    tr = R[0,0] + R[1,1] + R[2,2]
    if tr > 0:
        S = np.sqrt(tr + 1.0) * 2
        w = 0.25 * S
        x = (R[2,1] - R[1,2]) / S
        y = (R[0,2] - R[2,0]) / S
        z = (R[1,0] - R[0,1]) / S
    elif (R[0,0] > R[1,1]) and (R[0,0] > R[2,2]):
        S = np.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w = (R[2,1] - R[1,2]) / S
        x = 0.25 * S
        y = (R[0,1] + R[1,0]) / S
        z = (R[0,2] + R[2,0]) / S
    elif R[1,1] > R[2,2]:
        S = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
    return np.array([w, x, y, z])

# Segment red cube
red_masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
red_best = max(red_masks, key=lambda d: d["score"])
red_mask = red_best["mask"]
red_pts = mask_to_world_points(red_mask)
red_obb = get_oriented_bounding_box_from_3d_points(red_pts)
red_center = red_obb["center"]
red_extent = red_obb["extent"]

# Segment green cube
green_masks = segment_sam3_text_prompt(rgb, text_prompt="green cube")
green_best = max(green_masks, key=lambda d: d["score"])
green_mask = green_best["mask"]
green_pts = mask_to_world_points(green_mask)
green_obb = get_oriented_bounding_box_from_3d_points(green_pts)
green_center = green_obb["center"]
green_extent = green_obb["extent"]
green_top_z = green_center[2] + green_extent[2] / 2.0

# Plan grasp on red cube
grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=red_mask.astype(np.int32))
best_idx = int(np.argmax(grasp_scores))
best_T_world = cam_ext @ grasp_poses[best_idx]
grasp_pos = best_T_world[:3, 3]
grasp_R = best_T_world[:3, :3]
quat = rot_to_quat(grasp_R)

# Pre-grasp
open_gripper()
pre_pos = grasp_pos + np.array([0, 0, 0.12])
move_to_joints(solve_ik(pre_pos, quat))
move_to_joints(solve_ik(grasp_pos, quat))
close_gripper()

# Lift
lift_pos = grasp_pos + np.array([0, 0, 0.2])
move_to_joints(solve_ik(lift_pos, quat))

# Place above green cube
place_xy = green_center[:2]
place_z = green_top_z + red_extent[2] / 2.0 + 0.02
place_pos = np.array([place_xy[0], place_xy[1], place_z])

above_pos = place_pos + np.array([0, 0, 0.12])
move_to_joints(solve_ik(above_pos, quat))
move_to_joints(solve_ik(place_pos, quat))

open_gripper()

# Retreat
retreat_pos = place_pos + np.array([0, 0, 0.15])
move_to_joints(solve_ik(retreat_pos, quat))


