joints = solve_ik(pre_grasp_pos, down_quat)
move_to_joints(joints)

open_gripper()

# Move down to grasp
grasp_pos_down = grasp_pos.copy()
joints = solve_ik(grasp_pos_down, down_quat)
move_to_joints(joints)

close_gripper()

# Lift
