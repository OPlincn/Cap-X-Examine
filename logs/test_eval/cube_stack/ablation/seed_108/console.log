K = cam["intrinsics"]
cam_ext = cam["pose_mat"]

red_masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
green_masks = segment_sam3_text_prompt(rgb, text_prompt="green cube")

red_best = max(red_masks, key=lambda d: d["score"])
green_best = max(green_masks, key=lambda d: d["score"])
red_mask = red_best["mask"]
green_mask = green_best["mask"]

def mask_to_world_points(mask, depth, K, cam_ext):
    ys, xs = np.nonzero(mask)
    zs = depth[ys, xs]
    valid = zs > 0
    xs, ys, zs = xs[valid], ys[valid], zs[valid]
    fx, fy = K[0, 0], K[1, 1]
    cx, cy = K[0, 2], K[1, 2]
    x_cam = (xs - cx) * zs / fx
    y_cam = (ys - cy) * zs / fy
    pts_cam = np.stack([x_cam, y_cam, zs], axis=1)
    pts_cam_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0], 1))], axis=1)
    pts_world = (cam_ext @ pts_cam_h.T).T[:, :3]
    return pts_world

red_pts = mask_to_world_points(red_mask, depth, K, cam_ext)
green_pts = mask_to_world_points(green_mask, depth, K, cam_ext)

red_obb = get_oriented_bounding_box_from_3d_points(red_pts)
green_obb = get_oriented_bounding_box_from_3d_points(green_pts)

red_center = red_obb["center"]
green_center = green_obb["center"]
green_extent = green_obb["extent"]
red_extent = red_obb["extent"]

print("red_center", red_center, "red_extent", red_extent)
print("green_center", green_center, "green_extent", green_extent)

# Plan grasp on red cube
grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=red_mask.astype(np.int32))
best_idx = grasp_scores.argmax()
best_T_cam = grasp_poses[best_idx]
best_T_world = cam_ext @ best_T_cam

grasp_pos = best_T_world[:3, 3]
R = best_T_world[:3, :3]

def rot_to_quat(R):
    tr = np.trace(R)
    if tr > 0:
        S = np.sqrt(tr + 1.0) * 2
        w = 0.25 * S
        x = (R[2,1] - R[1,2]) / S
        y = (R[0,2] - R[2,0]) / S
        z = (R[1,0] - R[0,1]) / S
    elif (R[0,0] > R[1,1]) and (R[0,0] > R[2,2]):
        S = np.sqrt(1.0 + R[0,0] - R[1,1] - R[2,2]) * 2
        w = (R[2,1] - R[1,2]) / S
        x = 0.25 * S
        y = (R[0,1] + R[1,0]) / S
        z = (R[0,2] + R[2,0]) / S
    elif R[1,1] > R[2,2]:
        S = np.sqrt(1.0 + R[1,1] - R[0,0] - R[2,2]) * 2
        w = (R[0,2] - R[2,0]) / S
        x = (R[0,1] + R[1,0]) / S
        y = 0.25 * S
        z = (R[1,2] + R[2,1]) / S
    else:
        S = np.sqrt(1.0 + R[2,2] - R[0,0] - R[1,1]) * 2
        w = (R[1,0] - R[0,1]) / S
        x = (R[0,2] + R[2,0]) / S
        y = (R[1,2] + R[2,1]) / S
        z = 0.25 * S
    return np.array([w, x, y, z])

grasp_quat = rot_to_quat(R)
print("grasp_pos", grasp_pos, "grasp_quat", grasp_quat)

# Open gripper before approaching
open_gripper()

# Approach from above
approach_pos = grasp_pos + np.array([0, 0, 0.15])
joints = solve_ik(approach_pos, grasp_quat)
move_to_joints(joints)

# Move down to grasp
joints = solve_ik(grasp_pos, grasp_quat)
move_to_joints(joints)

close_gripper()

# Lift
lift_pos = grasp_pos + np.array([0, 0, 0.25])
joints = solve_ik(lift_pos, grasp_quat)
move_to_joints(joints)

# Verify grasp by checking red cube moved
obs2 = get_observation()
cam2 = obs2["robot0_robotview"]
rgb2 = cam2["images"]["rgb"]
depth2 = cam2["images"]["depth"]
K2 = cam2["intrinsics"]
cam_ext2 = cam2["pose_mat"]
red_masks2 = segment_sam3_text_prompt(rgb2, text_prompt="red cube")
red_best2 = max(red_masks2, key=lambda d: d["score"])
red_pts2 = mask_to_world_points(red_best2["mask"], depth2, K2, cam_ext2)
red_obb2 = get_oriented_bounding_box_from_3d_points(red_pts2)
red_center2 = red_obb2["center"]
print("red_center after lift", red_center2)

# Compute placement position: on top of green cube
place_pos = green_center.copy()
place_pos[2] = green_center[2] + green_extent[2] / 2 + red_extent[2] / 2 + 0.005

# Move above placement
above_place = place_pos + np.array([0, 0, 0.15])
joints = solve_ik(above_place, grasp_quat)
move_to_joints(joints)

# Lower to place
joints = solve_ik(place_pos, grasp_quat)
move_to_joints(joints)

# Open gripper
open_gripper()

# Retreat upward
retreat_pos = place_pos + np.array([0, 0, 0.2])
joints = solve_ik(retreat_pos, grasp_quat)
move_to_joints(joints)


