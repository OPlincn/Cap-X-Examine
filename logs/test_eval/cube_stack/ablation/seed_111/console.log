# Code block 0
import numpy as np

obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
cam_pose = cam["pose_mat"]

def get_best_mask(text):
    res = segment_sam3_text_prompt(rgb, text_prompt=text)
    if not res:
        return None
    return max(res, key=lambda d: d["score"])

red = get_best_mask("red cube")
green = get_best_mask("green cube")

def mask_to_world_points(mask):
    ys, xs = np.nonzero(mask)
    zs = depth[ys, xs]
    valid = zs > 0
    xs, ys, zs = xs[valid], ys[valid], zs[valid]
    pts_cam = np.stack([
        (xs - K[0,2]) * zs / K[0,0],
        (ys - K[1,2]) * zs / K[1,1],
        zs
    ], axis=1)
    pts_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0],1))], axis=1)
    pts_world = (cam_pose @ pts_h.T).T[:, :3]
    return pts_world

red_pts = mask_to_world_points(red["mask"])
green_pts = mask_to_world_points(green["mask"])

red_obb = get_oriented_bounding_box_from_3d_points(red_pts)
green_obb = get_oriented_bounding_box_from_3d_points(green_pts)

red_center = red_obb["center"]
green_center = green_obb["center"]
green_top_z = green_center[2] + green_obb["extent"][2] / 2.0
red_half_z = red_obb["extent"][2] / 2.0

# Grasp the red cube from above
grasp_pos = red_center.copy()
grasp_pos[2] = red_center[2] + red_obb["extent"][2] / 2.0 + 0.10
down_quat = np.array([0.0, 1.0, 0.0, 0.0])  # wxyz, gripper pointing down

open_gripper()
joints = solve_ik(grasp_pos, down_quat)
move_to_joints(joints)

# Move down to grasp
grasp_pos_low = red_center.copy()
grasp_pos_low[2] = red_center[2]
joints = solve_ik(grasp_pos_low, down_quat)
move_to_joints(joints)
close_gripper()

# Lift
lift_pos = grasp_pos_low.copy()
lift_pos[2] = green_top_z + red_half_z + 0.15
joints = solve_ik(lift_pos, down_quat)
move_to_joints(joints)

# Move above green cube
place_pos = np.array([green_center[0], green_center[1], green_top_z + red_half_z + 0.10])
joints = solve_ik(place_pos, down_quat)
move_to_joints(joints)

# Lower onto green cube
place_pos_low = np.array([green_center[0], green_center[1], green_top_z + red_half_z + 0.005])
joints = solve_ik(place_pos_low, down_quat)
move_to_joints(joints)

open_gripper()

# Retreat upward
retreat_pos = place_pos_low.copy()
retreat_pos[2] += 0.15
joints = solve_ik(retreat_pos, down_quat)
move_to_joints(joints)


