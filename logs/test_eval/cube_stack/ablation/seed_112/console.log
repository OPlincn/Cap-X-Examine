import numpy as np

obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
cam_ext = cam["pose_mat"]

def mask_to_world_points(mask, depth, K, cam_ext):
    ys, xs = np.nonzero(mask)
    zs = depth[ys, xs]
    valid = zs > 0
    xs, ys, zs = xs[valid], ys[valid], zs[valid]
    fx, fy = K[0, 0], K[1, 1]
    cx, cy = K[0, 2], K[1, 2]
    x = (xs - cx) * zs / fx
    y = (ys - cy) * zs / fy
    pts_cam = np.stack([x, y, zs], axis=1)
    pts_h = np.concatenate([pts_cam, np.ones((pts_cam.shape[0], 1))], axis=1)
    pts_world = (cam_ext @ pts_h.T).T[:, :3]
    return pts_world

# Re-segment green cube to get its top
green_masks = segment_sam3_text_prompt(rgb, text_prompt="green cube")
green_best = max(green_masks, key=lambda d: d["score"])
green_mask = green_best["mask"]
green_pts = mask_to_world_points(green_mask, depth, K, cam_ext)
green_obb = get_oriented_bounding_box_from_3d_points(green_pts)
green_center = green_obb["center"]
green_extent = green_obb["extent"]
green_top_z = green_center[2] + green_extent[2] / 2.0

# Re-segment red cube to find its current position (held in gripper)
red_masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
red_best = max(red_masks, key=lambda d: d["score"])
red_mask = red_best["mask"]
red_pts = mask_to_world_points(red_mask, depth, K, cam_ext)
red_obb = get_oriented_bounding_box_from_3d_points(red_pts)
red_center = red_obb["center"]
red_extent = red_obb["extent"]
red_bottom_z = red_center[2] - red_extent[2] / 2.0

grasp_quat = np.array([1.0, 0.0, 0.0, 0.0])

# Current gripper holds red cube; move above green cube
# Target: red cube bottom should sit on green top
# Offset between gripper and red cube bottom: assume gripper holds near red center
# Move so red cube center is at green_top_z + red_extent/2
target_red_center_z = green_top_z + red_extent[2] / 2.0
dz = target_red_center_z - red_center[2]

# Get current end-effector position via IK target from current red center
# Move to place position above green
place_xy = np.array([green_center[0], green_center[1]])

# First move up and over green
above_pos = np.array([place_xy[0], place_xy[1], red_center[2] + 0.10])
joints = solve_ik(above_pos, grasp_quat)
move_to_joints(joints)

# Lower to place position
place_pos = np.array([place_xy[0], place_xy[1], red_center[2] + dz])
joints = solve_ik(place_pos, grasp_quat)
move_to_joints(joints)

open_gripper()

# Retreat upward
retreat_pos = place_pos.copy()
retreat_pos[2] += 0.15
joints = solve_ik(retreat_pos, grasp_quat)
move_to_joints(joints)

