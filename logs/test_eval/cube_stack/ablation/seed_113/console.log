# Plan grasp on red cube
grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=red_mask.astype(np.int32))
best_idx = grasp_scores.argmax()
best_T_cam = grasp_poses[best_idx]
best_T_world = cam_ext @ best_T_cam

grasp_pos = best_T_world[:3, 3]
# Orientation: use top-down grasp (approach from above)
# Extract rotation, but force gripper pointing down for a top grasp
# We'll use a downward-facing orientation
quat_down = np.array([0.0, 1.0, 0.0, 0.0])  # wxyz, 180 deg about x -> gripper pointing down

# Pre-grasp above red cube
pre_grasp_pos = grasp_pos.copy()
pre_grasp_pos[2] += 0.10

open_gripper()
joints = solve_ik(pre_grasp_pos, quat_down)
move_to_joints(joints)

# Move down to grasp
joints = solve_ik(grasp_pos, quat_down)
move_to_joints(joints)

close_gripper()

# Lift
lift_pos = grasp_pos.copy()
lift_pos[2] += 0.15
joints = solve_ik(lift_pos, quat_down)
move_to_joints(joints)
