grasp_pos[2] = red_center[2] + 0.005
joints = solve_ik(grasp_pos, down_quat)
move_to_joints(joints)

close_gripper()

# Lift the red cube
lift_pos = red_center.copy()
lift_pos[2] = red_center[2] + 0.20
joints = solve_ik(lift_pos, down_quat)
move_to_joints(joints)
