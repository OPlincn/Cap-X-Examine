import numpy as np
obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
ext = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

# Recompute cube center in world frame
ys, xs = np.where(mask)
z = depth[ys, xs]
fx, fy = K[0,0], K[1,1]
cx, cy = K[0,2], K[1,2]
X = (xs - cx) * z / fx
Y = (ys - cy) * z / fy
pts_cam = np.stack([X, Y, z], axis=1)
pts_cam = pts_cam[np.isfinite(pts_cam[:,2]) & (pts_cam[:,2] > 0)]
R = ext[:3,:3]; t = ext[:3,3]
pts_world = (R @ pts_cam.T).T + t
obb = get_oriented_bounding_box_from_3d_points(pts_world)
center = obb["center"]
print("cube center now:", center)

# Move above cube, then descend, close, lift
above = center + np.array([0.0, 0.0, 0.15])
q_down = np.array([0.0, 1.0, 0.0, 0.0])  # gripper pointing down (wxyz)

open_gripper()
j_above = solve_ik(above, q_down)
move_to_joints(j_above)

# Descend to grasp height slightly above center
grasp_pos = center + np.array([0.0, 0.0, 0.02])
j_grasp = solve_ik(grasp_pos, q_down)
move_to_joints(j_grasp)

close_gripper()

lift_pos = center + np.array([0.0, 0.0, 0.20])
j_lift = solve_ik(lift_pos, q_down)
move_to_joints(j_lift)

print("lifted to", lift_pos)

