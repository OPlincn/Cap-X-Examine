import numpy as np

obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
extrinsics = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

grasp_poses, grasp_scores = plan_grasp(depth=depth, intrinsics=K, segmentation=mask)
print("num grasps:", len(grasp_poses), "scores:", grasp_scores)
best_idx = int(np.argmax(grasp_scores))
best_T = np.array(grasp_poses[best_idx], dtype=np.float64)
print("best_T shape:", best_T.shape)
print(best_T)

if best_T.shape == (3, 4):
    T4 = np.eye(4)
    T4[:3, :] = best_T
    best_T = T4

grasp_world = extrinsics @ best_T
pos = grasp_world[:3, 3]
R = grasp_world[:3, :3]

def rot_to_quat(R):
    t = np.trace(R)
    if t > 0:
        s = np.sqrt(t + 1.0) * 2
        w = 0.25 * s
        x = (R[2, 1] - R[1, 2]) / s
        y = (R[0, 2] - R[2, 0]) / s
        z = (R[1, 0] - R[0, 1]) / s
    elif R[0, 0] > R[1, 1] and R[0, 0] > R[2, 2]:
        s = np.sqrt(1.0 + R[0, 0] - R[1, 1] - R[2, 2]) * 2
        w = (R[2, 1] - R[1, 2]) / s
        x = 0.25 * s
        y = (R[0, 1] + R[1, 0]) / s
        z = (R[0, 2] + R[2, 0]) / s
    elif R[1, 1] > R[2, 2]:
        s = np.sqrt(1.0 + R[1, 1] - R[0, 0] - R[2, 2]) * 2
        w = (R[0, 2] - R[2, 0]) / s
        x = (R[0, 1] + R[1, 0]) / s
        y = 0.25 * s
        z = (R[1, 2] + R[2, 1]) / s
    else:
        s = np.sqrt(1.0 + R[2, 2] - R[0, 0] - R[1, 1]) * 2
        w = (R[1, 0] - R[0, 1]) / s
        x = (R[0, 2] + R[2, 0]) / s
        y = (R[1, 2] + R[2, 1]) / s
        z = 0.25 * s
    q = np.array([w, x, y, z])
    return q / np.linalg.norm(q)

quat = rot_to_quat(R)
print("grasp pos:", pos, "quat:", quat)

approach_pos = pos.copy()
approach_pos[2] += 0.12

open_gripper()
joints = solve_ik(approach_pos, quat)
move_to_joints(joints)

grasp_pos = pos.copy()
grasp_pos[2] -= 0.01
joints = solve_ik(grasp_pos, quat)
move_to_joints(joints)

close_gripper()

lift_pos = grasp_pos.copy()
lift_pos[2] += 0.20
joints = solve_ik(lift_pos, quat)
move_to_joints(joints)

print("Lift complete")

