# Filter green masks by actual green color to find the real cube
def is_green_mask(mask, rgb):
    pix = rgb[mask]
    if pix.shape[0] < 50:
        return False
    r = pix[:, 0].astype(float); g = pix[:, 1].astype(float); b = pix[:, 2].astype(float)
    return (g > r + 20) and (g > b + 20)

