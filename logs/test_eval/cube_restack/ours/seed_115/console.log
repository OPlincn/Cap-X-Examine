red_best = max(red_masks, key=lambda d: d["score"])
red_mask = red_best["mask"]
red_pts = mask_to_points(red_mask, depth, K, cam_ext)
red_obb = get_oriented_bounding_box_from_3d_points(red_pts)
red_extent = red_obb["extent"]

# Use a downward-facing gripper orientation for placement
place_quat = np.array([0.0, 1.0, 0.0, 0.0])  # wxyz, gripper pointing down

# Compute placement position on top of green cube
place_pos = green_center.copy()
place_pos[2] = green_center[2] + green_extent[2] / 2 + red_extent[2] / 2 + 0.005

# Move above placement location
