quat_xyzw = R.from_matrix(grasp_rot).as_quat()
quat_wxyz = np.array([quat_xyzw[3], quat_xyzw[0], quat_xyzw[1], quat_xyzw[2]])

# Pre-grasp: back off along approach axis (z of grasp frame)
