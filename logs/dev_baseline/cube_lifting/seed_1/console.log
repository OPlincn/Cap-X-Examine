import numpy as np

obs = get_observation()
cam = obs["robot0_robotview"]
rgb = cam["images"]["rgb"]
depth = cam["images"]["depth"]
K = cam["intrinsics"]
extrinsics = cam["pose_mat"]

masks = segment_sam3_text_prompt(rgb, text_prompt="red cube")
best = max(masks, key=lambda d: d["score"])
mask = best["mask"].astype(np.int32)

# Compute cube center in world frame from segmentation + depth
ys, xs = np.where(mask)
zs = depth[ys, xs]
valid = zs > 0
xs, ys, zs = xs[valid], ys[valid], zs[valid]

fx, fy = K[0, 0], K[1, 1]
cx, cy = K[0, 2], K[1, 2]
x_cam = (xs - cx) * zs / fx
y_cam = (ys - cy) * zs / fy
pts_cam = np.stack([x_cam, y_cam, zs], axis=1)

R_ext = extrinsics[:3, :3]
t_ext = extrinsics[:3, 3]
pts_world = (R_ext @ pts_cam.T).T + t_ext
cube_center = pts_world.mean(axis=0)
print("Cube center (world):", cube_center)

# Top-down grasp orientation: gripper pointing down.
# Identity quaternion makes the hand's z-axis point up; we want the gripper
# approaching from above, so rotate 180 deg about x-axis: [0,1,0,0]
quat = np.array([0.0, 1.0, 0.0, 0.0])

# Grasp slightly below the top surface center so fingers wrap the cube
grasp_pos = cube_center.copy()
grasp_pos[2] += 0.005

pre_pos = grasp_pos.copy()
pre_pos[2] += 0.12

open_gripper()
joints_pre = solve_ik(pre_pos, quat)
move_to_joints(joints_pre)

joints_grasp = solve_ik(grasp_pos, quat)
move_to_joints(joints_grasp)

close_gripper()

lift_pos = grasp_pos.copy()
lift_pos[2] += 0.20
joints_lift = solve_ik(lift_pos, quat)
move_to_joints(joints_lift)

print("Grasp position:", grasp_pos)
print("Lift position:", lift_pos)


